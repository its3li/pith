# Copy this file to .env next to the app and fill in your own values.
# Never commit your real .env file.

# Required: your Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Optional: any OpenAI-compatible endpoint works here.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Transcription ---------------------------------------------------------

# Primary speech-to-text model, and the model used if it is unavailable.
PITH_STT_MODEL=whisper-large-v3
PITH_STT_FALLBACK=whisper-large-v3-turbo

# Spoken language. Blank means auto-detect, so English stays English and Arabic
# stays Arabic. Set an explicit code (en, ar, ...) only to bias detection.
PITH_LANGUAGE=

# --- Transcript cleanup ----------------------------------------------------

# Sends the transcript to an LLM that strips fillers ("um", "you know") and
# applies spoken self-corrections, so "I bought it for ten dollars, no actually
# for twenty" comes out as "I bought it for twenty".
# Set to 0 to paste the raw, verbatim transcript instead.
PITH_FIX=1
PITH_FIX_MODEL=qwen/qwen3.8-27b
PITH_FIX_FALLBACK=qwen/qwen3.6-27b

# Skip the cleanup round trip for anything shorter than this many words.
PITH_FIX_MIN_WORDS=4

# Seconds to wait for cleanup before pasting the raw transcript instead.
PITH_FIX_TIMEOUT=4.0

# --- Behaviour -------------------------------------------------------------

# Stop recording on Enter as well as on the toggle hotkey. On by default. Enter
# is captured only for the duration of the recording and suppressed while it is,
# so it stops the dictation without reaching the app underneath -- set this to 0
# if you would rather Enter always went straight through.
PITH_STOP_ON_ENTER=1

# Put your previous clipboard back after pasting. Set to 0 to leave the
# transcript on the clipboard permanently.
PITH_KEEP_CLIPBOARD=1
PITH_CLIPBOARD_RESTORE_MS=250

# Prepend a space to the pasted text, for dictating onto the end of half-typed
# text. Off by default, since it is wrong when the field is empty.
PITH_LEADING_SPACE=0

# Transcripts kept in the tray menu for re-copying.
PITH_HISTORY_SIZE=5

# --- Audio -----------------------------------------------------------------

# Silence trimming sensitivity. Higher trims more; lower keeps quieter audio.
PITH_SILENCE_THRESHOLD=500

# Padding kept around detected speech, in milliseconds.
PITH_TRIM_PADDING_MS=250

# Recordings larger than this are uploaded as FLAC (about half the size of WAV)
# instead of WAV, which uploads faster at the cost of a little encoding time.
PITH_FLAC_THRESHOLD_KB=600

# Hard cap on a single recording, in seconds.
PITH_MAX_SECONDS=600

# Seconds to wait for a transcription response.
PITH_REQUEST_TIMEOUT=60
